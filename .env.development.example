# Development Environment Configuration
# Copy this file to .env.development for local development.

# API Configuration - use CRA proxy mode in development
REACT_APP_API_URL=/api

# Socket configuration
# Use same-origin relative URL in development via setupProxy
REACT_APP_SOCKET_URL=/
REACT_APP_SOCKET_PATH=/socket.io

# Fast Refresh (Hot Module Replacement)
FAST_REFRESH=true

# Optional DX toggles
REACT_APP_DISABLE_STRICT_MODE_WARNINGS=true
WDS_SOCKET_PORT=0
WDS_SOCKET_HOST=0.0.0.0
BROWSER=none

# Optional debug settings
REACT_APP_DEBUG_PROXY=false
REACT_APP_SOCKET_RECONNECTION_ATTEMPTS=3
REACT_APP_SOCKET_RECONNECTION_DELAY=2000
