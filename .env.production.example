# Production Environment Configuration
# Copy this file to .env.production and set real deployment values.

# REQUIRED: Frontend API base URL (absolute URL or explicit relative /api)
REACT_APP_API_URL=https://api.example.com/api

# REQUIRED: Socket server base URL (absolute URL or explicit relative /)
REACT_APP_SOCKET_URL=https://api.example.com
REACT_APP_SOCKET_PATH=/socket.io

# Optional frontend origin metadata
REACT_APP_FRONTEND_URL=https://app.example.com
REACT_APP_APP_URL=https://app.example.com

# Optional browser socket tuning
REACT_APP_SOCKET_RECONNECTION_ATTEMPTS=5
REACT_APP_SOCKET_RECONNECTION_DELAY=2000
